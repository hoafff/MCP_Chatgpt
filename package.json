{
  "name": "mcp-chatgpt-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows MCP server for ChatGPT: safe filesystem, PowerShell/process and Git tools.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
